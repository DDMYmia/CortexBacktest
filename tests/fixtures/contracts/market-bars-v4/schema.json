{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "market-bars-v4",
  "type": "object",
  "required": [
    "contractVersion",
    "instrumentId",
    "sessionDate",
    "adjustment",
    "ohlcBasis",
    "source",
    "adjustmentProvenance",
    "sessionClose",
    "sourceKnownAt",
    "recordedAt",
    "availableAt",
    "asOf",
    "open",
    "high",
    "low",
    "close",
    "adjClose",
    "volume",
    "invalidReason"
  ],
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "market-bars-v4"
    },
    "instrumentId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "sessionDate": {
      "type": "string",
      "format": "date"
    },
    "adjustment": {
      "type": "string",
      "enum": [
        "unadjusted",
        "split",
        "total_return"
      ]
    },
    "ohlcBasis": {
      "anyOf": [
        {
          "type": "string",
          "const": "unadjusted"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "adjustmentProvenance": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "sessionClose": {
      "type": "string",
      "format": "date-time"
    },
    "sourceKnownAt": {
      "type": "string",
      "format": "date-time"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "availableAt": {
      "type": "string",
      "format": "date-time"
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "open": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1.7976931348623157e+308,
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "high": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1.7976931348623157e+308,
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "low": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1.7976931348623157e+308,
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "close": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1.7976931348623157e+308,
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "adjClose": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1.7976931348623157e+308,
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "volume": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1.7976931348623157e+308
        },
        {
          "type": "null"
        }
      ]
    },
    "invalidReason": {
      "enum": [
        null,
        "unverified_price_basis"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "invalidReason": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "open": {
            "type": "number",
            "minimum": 0,
            "maximum": 1.7976931348623157e+308,
            "exclusiveMinimum": 0
          },
          "high": {
            "type": "number",
            "minimum": 0,
            "maximum": 1.7976931348623157e+308,
            "exclusiveMinimum": 0
          },
          "low": {
            "type": "number",
            "minimum": 0,
            "maximum": 1.7976931348623157e+308,
            "exclusiveMinimum": 0
          },
          "close": {
            "type": "number",
            "minimum": 0,
            "maximum": 1.7976931348623157e+308,
            "exclusiveMinimum": 0
          },
          "adjClose": {
            "type": "number",
            "minimum": 0,
            "maximum": 1.7976931348623157e+308,
            "exclusiveMinimum": 0
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1.7976931348623157e+308
          },
          "ohlcBasis": {
            "type": "string",
            "const": "unadjusted"
          },
          "adjustmentProvenance": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "open": {
            "type": "null"
          },
          "high": {
            "type": "null"
          },
          "low": {
            "type": "null"
          },
          "close": {
            "type": "null"
          },
          "adjClose": {
            "type": "null"
          },
          "volume": {
            "type": "null"
          },
          "ohlcBasis": {
            "type": "null"
          },
          "adjustmentProvenance": {
            "type": "null"
          }
        }
      }
    }
  ]
}
