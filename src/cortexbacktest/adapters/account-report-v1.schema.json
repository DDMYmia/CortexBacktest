{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "account-report-v1",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "account-report-v1"
    },
    "sourceReportSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "delivery": {
      "description": "Optional and not covered by sourceReportSha256: what the producer delivered and how the download run behind it ended.",
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "accountOpened", "archiveRun"],
      "properties": {
        "scope": {"enum": ["interval", "lifetime"]},
        "accountOpened": {"type": ["string", "null"], "format": "date"},
        "archiveRun": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["finishedAt", "status", "pendingRanges"],
          "properties": {
            "finishedAt": {"type": "string", "format": "date-time"},
            "status": {"enum": ["completed", "coverage_pending", "partial_failure"]},
            "pendingRanges": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "report": {
      "type": "object",
      "properties": {
        "activity_included": {
          "const": true
        },
        "schema_version": {
          "const": 1
        },
        "scope": {
          "const": "broker_account_facts"
        },
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        },
        "opening_date": {
          "type": "string",
          "format": "date"
        },
        "account_id": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "ledger_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "position_boundary_sources": {
          "type": "object",
          "propertyNames": {
            "format": "date"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "statement_index": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "source_sha256",
                "statement_index"
              ],
              "additionalProperties": false
            },
            "maxItems": 100000
          },
          "minProperties": 2,
          "maxProperties": 2
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1
          },
          "maxItems": 100000,
          "uniqueItems": true
        },
        "review_events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 1024,
                  "minLength": 1
                },
                "maxItems": 100000,
                "uniqueItems": true
              }
            },
            "required": [
              "event_id",
              "issues"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        },
        "review_evidence": {
          "type": "array", "maxItems": 100000,
          "items": {"$ref": "#/$defs/reviewEvidence"}
        },
        "missing_sections": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1
          },
          "maxItems": 100000,
          "uniqueItems": true
        },
        "positions": {
          "type": "array", "maxItems": 100000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["conid", "currency", "model", "opening_quantity", "closing_quantity"],
            "properties": {
              "conid": {"type": "string", "maxLength": 1024, "minLength": 1},
              "currency": {"type": "string", "maxLength": 1024, "minLength": 1},
              "model": {"type": "string", "maxLength": 1024},
              "opening_quantity": {"$ref": "#/$defs/nullableDecimal"},
              "closing_quantity": {"$ref": "#/$defs/nullableDecimal"}
            }
          }
        },
        "cash_date_basis": {"const": "report_date_with_legacy_datetime_fallback"},
        "included_cash_event_ids": {"type": "array", "maxItems": 100000, "uniqueItems": true, "items": {"$ref": "#/$defs/sha"}},
        "archive_analysis": {
          "type": "object", "additionalProperties": false,
          "required": ["basis", "account_id", "sources", "nav"],
          "properties": {
            "basis": {"const": "broker_archive_observations_not_reconciled"},
            "account_id": {"type": "string", "minLength": 1, "maxLength": 1024},
            "sources": {"type": "array", "maxItems": 10000, "items": {
              "type": "object", "additionalProperties": false,
              "required": ["profile", "sha256", "statement_indices", "section_observations"],
              "properties": {
                "profile": {"enum": ["full_archive", "trade_confirmations"]},
                "sha256": {"$ref": "#/$defs/sha"},
                "statement_indices": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
                "section_observations": {"type": "object", "maxProperties": 200, "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9]{0,100}$"}, "additionalProperties": {"type": "integer", "minimum": 0}}
              }
            }},
            "returns": {"type": "array", "maxItems": 100000, "items": {
              "type": "object", "additionalProperties": false,
              "required": ["date", "currency", "model", "status", "variants"],
              "properties": {
                "date": {"type": "string", "format": "date"},
                "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
                "model": {"type": "string", "maxLength": 1024},
                "status": {"enum": ["observed", "conflict"]},
                "variants": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {
                  "type": "object", "additionalProperties": false, "required": ["values", "observations"],
                  "properties": {
                    "values": {"type": "object", "additionalProperties": false, "required": ["startingValue", "endingValue", "twr"], "properties": {
                      "startingValue": {"$ref": "#/$defs/decimal"}, "endingValue": {"$ref": "#/$defs/decimal"}, "twr": {"$ref": "#/$defs/decimal"}
                    }},
                    "observations": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {
                      "type": "object", "additionalProperties": false, "required": ["source_sha256", "statement_index", "row_index", "raw_record_sha256"],
                      "properties": {
                        "source_sha256": {"$ref": "#/$defs/sha"}, "raw_record_sha256": {"$ref": "#/$defs/sha"},
                        "statement_index": {"type": "integer", "minimum": 0}, "row_index": {"const": 0}
                      }
                    }}
                  }
                }}
              }
            }},
            "nav": {"type": "array", "maxItems": 100000, "items": {
              "type": "object", "additionalProperties": false,
              "required": ["date", "currency", "model", "status", "variants"],
              "properties": {
                "date": {"type": "string", "format": "date"},
                "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
                "model": {"type": "string", "maxLength": 1024},
                "status": {"enum": ["observed", "conflict"]},
                "variants": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {
                  "type": "object", "additionalProperties": false, "required": ["values", "observations"],
                  "properties": {
                    "values": {"type": "object", "additionalProperties": false, "required": ["total", "cash", "stock", "options"], "properties": {
                      "total": {"$ref": "#/$defs/decimal"}, "cash": {"$ref": "#/$defs/decimal"},
                      "stock": {"$ref": "#/$defs/decimal"}, "options": {"$ref": "#/$defs/decimal"}
                    }},
                    "observations": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {
                      "type": "object", "additionalProperties": false, "required": ["source_sha256", "statement_index", "row_index", "raw_record_sha256"],
                      "properties": {
                        "source_sha256": {"$ref": "#/$defs/sha"}, "raw_record_sha256": {"$ref": "#/$defs/sha"},
                        "statement_index": {"type": "integer", "minimum": 0}, "row_index": {"type": "integer", "minimum": 0}
                      }
                    }}
                  }
                }}
              }
            }}
          }
        },
        "daily_returns": {
          "type": "object", "additionalProperties": false,
          "required": ["basis", "base_currency", "days"],
          "properties": {
            "basis": {"const": "broker_twr_with_ledger_flows"},
            "base_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
            "days": {"type": "array", "maxItems": 100000, "items": {"type": "object", "additionalProperties": false,
              "required": ["date", "prior_date", "prior_nav", "nav", "twr", "flow", "issues"],
              "properties": {
                "date": {"type": "string", "format": "date"},
                "prior_date": {"anyOf": [{"type": "null"}, {"type": "string", "format": "date"}]},
                "prior_nav": {"$ref": "#/$defs/nullableDecimal"}, "nav": {"$ref": "#/$defs/nullableDecimal"},
                "twr": {"$ref": "#/$defs/nullableDecimal"}, "flow": {"$ref": "#/$defs/decimal"},
                "flow_sources": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "object", "additionalProperties": false,
                  "required": ["event_id", "currency", "amount", "rate"],
                  "properties": {"event_id": {"$ref": "#/$defs/sha"}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
                    "amount": {"$ref": "#/$defs/decimal"}, "rate": {"$ref": "#/$defs/decimal"}}}},
                "issues": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"enum": [
                  "missing_fx_rate", "fx_rate_conflict", "flow_event_unresolved", "missing_prior_nav", "prior_nav_conflict",
                  "missing_nav", "nav_conflict", "missing_twr", "twr_conflict"]}}}}}
          }
        },
        "funds_statements": {
          "type": "array", "maxItems": 1000, "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["source_sha256", "statement_index", "account_id", "from", "to", "currency", "rows", "cash_reports"],
            "properties": {
              "source_sha256": {"$ref": "#/$defs/sha"},
              "statement_index": {"type": "integer", "minimum": 0},
              "account_id": {"type": "string", "minLength": 1, "maxLength": 1024},
              "from": {"type": "string", "format": "date"}, "to": {"type": "string", "format": "date"},
              "currency": {"type": "string", "minLength": 1, "maxLength": 16},
              "rows": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {
                "type": "object", "additionalProperties": false,
                "required": ["row_index", "activityCode", "activityDescription", "reportDate", "model", "amount", "debit", "credit", "balance"],
                "properties": {
                  "row_index": {"type": "integer", "minimum": 0},
                  "activityCode": {"type": "string", "maxLength": 128},
                  "activityDescription": {"type": "string", "maxLength": 1024},
                  "reportDate": {"type": "string", "pattern": "^[0-9]{8}$"},
                  "model": {"type": "string", "maxLength": 1024},
                  "amount": {"$ref": "#/$defs/decimal"}, "balance": {"$ref": "#/$defs/decimal"},
                  "debit": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"const": ""}]},
                  "credit": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"const": ""}]}
                }
              }},
              "cash_reports": {"type": "array", "maxItems": 1000, "items": {
                "type": "object", "additionalProperties": false,
                "required": ["fromDate", "toDate", "model", "startingCash", "endingCash"],
                "properties": {
                  "fromDate": {"type": "string", "pattern": "^[0-9]{8}$"},
                  "toDate": {"type": "string", "pattern": "^[0-9]{8}$"},
                  "model": {"type": "string", "maxLength": 1024},
                  "startingCash": {"$ref": "#/$defs/decimal"}, "endingCash": {"$ref": "#/$defs/decimal"}
                }
              }}
            }
          }
        },
        "commission_sums_by_currency": {
          "type": "object",
          "propertyNames": {
            "minLength": 1,
            "maxLength": 16
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[Ee][+-]?[0-9]+)?$"
          }
        },
        "cash_transaction_sums": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "currency": {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1
              },
              "type": {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1
              },
              "amount": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[Ee][+-]?[0-9]+)?$"
              }
            },
            "required": [
              "currency",
              "type",
              "amount"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        },
        "included_trade_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "maxItems": 100000,
          "uniqueItems": true
        },
        "excluded_trade_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "maxItems": 100000,
          "uniqueItems": true
        },
        "aggregation": {
          "type": "object",
          "properties": {
            "excluded_cash_event_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "maxItems": 100000,
              "uniqueItems": true
            },
            "cash_transactions_covered": {
              "type": "boolean"
            },
            "trade_reports_covered": {
              "type": "boolean"
            }
          },
          "required": [
            "excluded_cash_event_ids",
            "cash_transactions_covered",
            "trade_reports_covered"
          ],
          "additionalProperties": false
        },
        "summary": {
          "type": "object", "additionalProperties": false,
          "required": ["review_events", "excluded_trades"],
          "properties": {
            "review_events": {"type": "integer", "minimum": 0},
            "excluded_trades": {"type": "integer", "minimum": 0}
          }
        }
      },
      "required": [
        "schema_version",
        "scope",
        "from",
        "to",
        "opening_date",
        "account_id",
        "ledger_sha256",
        "position_boundary_sources",
        "issues",
        "review_events",
        "missing_sections",
        "positions",
        "commission_sums_by_currency",
        "cash_transaction_sums",
        "included_trade_event_ids",
        "excluded_trade_event_ids",
        "aggregation",
        "summary"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contractVersion",
    "sourceReportSha256",
    "report"
  ],
  "$defs": {
    "decimal": {"type": "string", "maxLength": 200,
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[Ee][+-]?[0-9]+)?$"},
    "nullableDecimal": {
      "anyOf": [{"type": "null"}, {"type": "string", "maxLength": 200,
        "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[Ee][+-]?[0-9]+)?$"}]
    },
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {"type": "array", "maxItems": 1000, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "reviewEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "identity", "kind", "conflicting_fields", "issues", "links", "variants"],
      "properties": {
        "event_id": {"$ref": "#/$defs/sha"},
        "identity": {"type": "array", "minItems": 3, "maxItems": 20,
          "items": {"type": "string", "maxLength": 1024}},
        "kind": {"enum": ["trade", "cash", "position", "corporate_action", "option_lifecycle", "cash_report", "transfer", "stock_grant"]},
        "conflicting_fields": {"$ref": "#/$defs/strings"},
        "issues": {"$ref": "#/$defs/strings"},
        "links": {
          "type": "array", "maxItems": 1000, "uniqueItems": true,
          "items": {"type": "object", "additionalProperties": false,
            "required": ["field", "value", "target_event_ids"],
            "properties": {
              "field": {"type": "string", "minLength": 1, "maxLength": 1024},
              "value": {"type": "string", "minLength": 1, "maxLength": 1024},
              "target_event_ids": {"type": "array", "maxItems": 1000, "uniqueItems": true,
                "items": {"$ref": "#/$defs/sha"}}
            }
          }
        },
        "variants": {
          "type": "array", "minItems": 1, "maxItems": 1000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["version_sha256", "fields", "observations"],
            "properties": {
              "version_sha256": {"$ref": "#/$defs/sha"},
              "fields": {"type": "object", "minProperties": 1, "maxProperties": 1000,
                "propertyNames": {"minLength": 1, "maxLength": 1024},
                "additionalProperties": {"type": "string", "maxLength": 16384}},
              "observations": {
                "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["source_sha256", "statement_index", "row_index", "raw_record_sha256", "report_from", "report_to"],
                  "properties": {
                    "source_sha256": {"$ref": "#/$defs/sha"},
                    "statement_index": {"type": "integer", "minimum": 0},
                    "row_index": {"type": "integer", "minimum": 0},
                    "raw_record_sha256": {"$ref": "#/$defs/sha"},
                    "report_from": {"type": "string", "format": "date"},
                    "report_to": {"type": "string", "format": "date"}
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
