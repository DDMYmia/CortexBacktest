{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "market-bars-v2",
  "type": "object",
  "required": [
    "contractVersion",
    "instrumentId",
    "sessionDate",
    "adjustment",
    "ohlcBasis",
    "source",
    "adjustmentProvenance",
    "sessionClose",
    "sourceKnownAt",
    "recordedAt",
    "availableAt",
    "asOf",
    "open",
    "high",
    "low",
    "close",
    "adjClose",
    "volume"
  ],
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "market-bars-v2"
    },
    "instrumentId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "sessionDate": {
      "type": "string",
      "format": "date"
    },
    "adjustment": {
      "type": "string",
      "enum": [
        "unadjusted",
        "split",
        "total_return"
      ]
    },
    "ohlcBasis": {
      "type": "string",
      "const": "unadjusted"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "adjustmentProvenance": {
      "type": "string",
      "minLength": 1
    },
    "sessionClose": {
      "type": "string",
      "format": "date-time"
    },
    "sourceKnownAt": {
      "type": "string",
      "format": "date-time"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "availableAt": {
      "type": "string",
      "format": "date-time"
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "open": {
      "type": "number",
      "minimum": 0,
      "maximum": 1.7976931348623157e+308,
      "exclusiveMinimum": 0
    },
    "high": {
      "type": "number",
      "minimum": 0,
      "maximum": 1.7976931348623157e+308,
      "exclusiveMinimum": 0
    },
    "low": {
      "type": "number",
      "minimum": 0,
      "maximum": 1.7976931348623157e+308,
      "exclusiveMinimum": 0
    },
    "close": {
      "type": "number",
      "minimum": 0,
      "maximum": 1.7976931348623157e+308,
      "exclusiveMinimum": 0
    },
    "adjClose": {
      "type": "number",
      "minimum": 0,
      "maximum": 1.7976931348623157e+308,
      "exclusiveMinimum": 0
    },
    "volume": {
      "type": "number",
      "minimum": 0,
      "maximum": 1.7976931348623157e+308
    }
  },
  "additionalProperties": false
}
